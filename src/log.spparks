SPPARKS (27 Nov 2024)

variable SEED equal                 1

variable T equal                 0.034469333048


app_style   diffusion_custom linear  hop nn_model.json shells.json 
dimension	 3


boundary p p p

#lattice     sc/6n 1
lattice 	fcc 1

region      box block 0 10 0 10 0 20
create_box  box 
Created box = (0 0 0) to (10 10 20)
  1 by 1 by 1 processor grid
# region      origin block 0 3 0 3 0 3

create_sites region box value site 1
Creating sites ...
  8000 sites
  8000 sites have 12 neighbors

seed		 ${SEED}
seed		 1

variable 	c loop 39


label 		cloop

variable 	p equal (v_c)*0.5
print 		$p
print 		0.5
0.5
if $p < 10  then "variable o equal v_p*0.05" else "variable o equal (20-v_p)*0.05 "
if 0.5 < 10  then "variable o equal v_p*0.05" else "variable o equal (20-v_p)*0.05 "
variable o equal v_p*0.05


set     site value 2 if z = $p fraction $o
set     site value 2 if z = 0.5 fraction $o
set     site value 2 if z = 0.5 fraction 0.025
  8 settings made for site

next 	c
